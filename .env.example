# Copy to .env and fill in. .env is git-ignored; deploy.sh turns it into a Kubernetes Secret.
POSTGRES_USER=reviewer
POSTGRES_PASSWORD=change-this-db-password
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=admin123
# GitHub personal access token (classic, 'repo' scope) - used to read PR files and post comments
GITHUB_TOKEN=ghp_your_token_here
# Must be identical to the "Secret" you type in the GitHub webhook settings
WEBHOOK_SECRET=change-this-webhook-secret
# Optional: Anthropic API key for the AI review. Leave empty to skip AI review.
LLM_API_KEY=
